---
const { experience } = Astro.props;
---

<section id="experience" class="section container">
  <div class="section-heading">
    <span class="eyebrow">Experiência</span>
    <h2>Experiência profissional</h2>
  </div>

  <div class="experience-list">
    {
      experience.map((item: any) => (
        <article class="experience-card">
          <div class="experience-header">
            <div>
              <h3>{item.role}</h3>
              <p>{item.company}</p>
            </div>

            <span class="period">{item.period}</span>
          </div>

          <ul>
            {
              item.highlights.map((highlight: string) => (
                <li>{highlight}</li>
              ))
            }
          </ul>

          {item.project && (
            <a
              href={item.project}
              target="_blank"
              rel="noopener noreferrer"
              class="experience-project"
            >
              Conhecer projeto <span>↗</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 28px;
  }

  .experience-card {
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-white);
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 14px;
  }

  .experience-header h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
  }

  .experience-header p {
    margin: 4px 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .period {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .experience-card ul {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-left: 18px;
    margin: 0;
  }

  .experience-card li {
    padding-left: 3px;
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .experience-project {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .experience-project:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .experience-header {
      flex-direction: column;
      gap: 5px;
    }

    .experience-card {
      padding: 18px;
    }
  }
</style>