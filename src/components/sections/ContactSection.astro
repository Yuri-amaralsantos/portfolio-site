---
const { profile } = Astro.props;
---

<section
  id="contact"
  class="section container"
>
  <div class="contact">
    <div class="contact-content">
      <span class="eyebrow">
        Contato
      </span>

      <h2>
        Vamos conversar?
      </h2>

      <p>
        Estou aberto a oportunidades e projetos
        relacionados a desenvolvimento Full Stack.
      </p>
    </div>

    <div class="contact-links">
      <a
        class="contact-link"
        href={profile.social.email}
      >
        <span class="contact-icon">@</span>

        <span>
          <strong>E-mail</strong>
          <small>Entre em contato por e-mail</small>
        </span>

        <span class="arrow">↗</span>
      </a>

      <a
        class="contact-link"
        href={profile.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-icon">in</span>

        <span>
          <strong>LinkedIn</strong>
          <small>Meu perfil profissional</small>
        </span>

        <span class="arrow">↗</span>
      </a>

      <a
        class="contact-link"
        href={profile.social.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-icon">GH</span>

        <span>
          <strong>GitHub</strong>
          <small>Projetos e código</small>
        </span>

        <span class="arrow">↗</span>
      </a>

      <a
        class="contact-link"
        href={profile.social.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-icon">WA</span>

        <span>
          <strong>WhatsApp</strong>
          <small>Fale comigo diretamente</small>
        </span>

        <span class="arrow">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;

    padding: 70px 0 100px;

    border-top: 1px solid var(--color-border);
  }

  .contact-content {
    max-width: 480px;
  }

  .contact-content h2 {
    margin: 10px 0 16px;

    color: var(--color-text);

    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .contact-content p {
    margin: 0;

    color: var(--color-text-muted);

    font-size: 1rem;
    line-height: 1.7;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 14px;

    padding: 15px 16px;

    border: 1px solid var(--color-border);
    border-radius: 12px;

    background: var(--color-white);

    color: var(--color-text);
    text-decoration: none;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-link:hover {
    transform: translateX(4px);

    border-color: var(--color-blue);

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  }

  .contact-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 9px;

    background: var(--color-tag-background);
    color: var(--color-blue);

    font-size: 0.72rem;
    font-weight: 800;
  }

  .contact-link > span:nth-child(2) {
    display: flex;
    flex-direction: column;
    gap: 2px;

    min-width: 0;
  }

  .contact-link strong {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .contact-link small {
    color: var(--color-text-muted);

    font-size: 0.75rem;
  }

  .arrow {
    margin-left: auto;

    color: var(--color-text-muted);

    font-size: 1rem;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .contact-link:hover .arrow {
    color: var(--color-blue);
    transform: translate(2px, -2px);
  }

  @media (max-width: 700px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 32px;

      padding: 60px 0 70px;
    }

    .contact-content h2 {
      font-size: 2.2rem;
    }
  }
</style>