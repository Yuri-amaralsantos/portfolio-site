---
const { languages } = Astro.props;
---

<section id="languages" class="section container">
  <div class="section-heading">
    <span class="eyebrow">
      Comunicação
    </span>

    <h2>
      Idiomas
    </h2>

    <p class="muted">
      Idiomas e níveis de proficiência.
    </p>
  </div>

  <div class="languages-grid">
    {
      languages.map((language: any) => (
        <article class="language-card">
          <div class="language-icon">
            {language.name === "Português" ? "PT" : "EN"}
          </div>

          <div class="language-info">
            <h3>{language.name}</h3>
            <p>{language.level}</p>
          </div>

          <span class="language-status">
            {language.level}
          </span>
        </article>
      ))
    }
  </div>
</section>

<style>
  .languages-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .language-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-white);
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .language-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-hover);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }

  .language-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--color-tag-background);
    color: var(--color-blue);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .language-info {
    flex: 1;
    min-width: 0;
  }

  .language-info h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
  }

  .language-info p {
    margin: 4px 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .language-status {
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--color-tag-background);
    color: var(--color-tag-text);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .languages-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 450px) {
    .language-card {
      flex-wrap: wrap;
    }
  }
</style>