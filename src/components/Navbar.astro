---
import { profile } from "../data/portfolio.js";
---

<nav class="nav">
  <div class="nav-inner">

    <a class="logo" href="#home">
      Yuri<span>.</span>
    </a>

    <div class="links">
      <a href="#home">
        Início
      </a>

      <a href="#experience">
        Experiência
      </a>

      <a href="#projects">
        Projetos
      </a>

      <a href="#stack">
        Stack
      </a>

      <a href="#education">
        Formação
      </a>

      <a href="#languages">
        Idiomas
      </a>

      <a href="#contact">
        Contato
      </a>

      <a
        class="resume"
        href={profile.resume}
        download
      >
        Currículo
      </a>
    </div>

  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);

    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;

    padding: 16px 0;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-text);

    font-size: 1.3rem;
    font-weight: 800;

    text-decoration: none;

    letter-spacing: -0.04em;

    flex-shrink: 0;
  }

  .logo span {
    color: var(--color-blue);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .links a {
    color: var(--color-text);

    text-decoration: none;

    font-size: 0.85rem;
    font-weight: 500;

    white-space: nowrap;

    opacity: 0.65;

    transition:
      opacity 0.2s ease,
      color 0.2s ease;
  }

  .links a:hover {
    color: var(--color-blue);
    opacity: 1;
  }

  .resume {
    padding: 9px 14px;

    border: 1px solid var(--color-border);
    border-radius: 9px;

    opacity: 1 !important;

    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .resume:hover {
    border-color: var(--color-blue);
    background: var(--color-tag-background);
  }

  @media (max-width: 900px) {
    .links {
      gap: 13px;
    }

    .links a {
      font-size: 0.8rem;
    }

    .resume {
      padding: 8px 11px;
    }
  }

  @media (max-width: 700px) {
    .nav-inner {
      width: min(100% - 24px, 1100px);
    }

    .links {
      max-width: calc(100vw - 90px);

      overflow-x: auto;

      justify-content: flex-start;

      scrollbar-width: none;

      gap: 16px;

      padding-bottom: 2px;
    }

    .links::-webkit-scrollbar {
      display: none;
    }

    .links a {
      font-size: 0.8rem;
    }
  }
</style>